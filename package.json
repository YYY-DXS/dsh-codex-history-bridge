{
    "description":  "Import local Codex conversation history into the workspace as Markdown transcripts, an index, and an optional raw copy.",
    "type":  "module",
    "exports":  {
                    ".":  "./index.js",
                    "./locale/*.json":  "./locale/*.json",
                    "./icon":  "./icon.svg"
                },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           }
            },
    "name":  "dsh-codex-history-bridge",
    "version":  "0.1.0",
    "private":  false,
    "license":  "MIT",
    "keywords":  [
                     "dsh",
                     "dsh-plugin",
                     "deepseek-harness",
                     "deepseek",
                     "codex-history-bridge"
                 ],
    "homepage":  "https://github.com/YYY-DXS/dsh-codex-history-bridge#readme",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/YYY-DXS/dsh-codex-history-bridge.git"
                   },
    "bugs":  {
                 "url":  "https://github.com/YYY-DXS/dsh-codex-history-bridge/issues"
             },
    "engines":  {
                    "node":  ">=18",
                    "dsh":  ">=0.1.0-rc.6 <0.3.0-0"
                },
    "files":  [
                  "index.js",
                  "cordis.patch.yml",
                  "scripts/import_codex_history.py",
                  "locale/*.json",
                  "icon.svg",
                  "README.md",
                  "LICENSE"
              ]
}